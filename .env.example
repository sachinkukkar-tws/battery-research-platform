# "mock" uses the sample data and canned demo answers bundled in src/data.
# "live" calls the platform API and the Amplifi proxy below.
VITE_DATA_MODE=mock

# Ask Amplifi only. "live" sends chat to the Amplifi proxy while every other screen keeps VITE_DATA_MODE.
# Run the proxy with `npm run amplifi:proxy` (settings in .env.amplifi) and set AMPLIFI_PROXY_TARGET below.
VITE_CHAT_MODE=mock

# Where the Vite dev server forwards /amplifi. Matches the proxy's default port.
# AMPLIFI_PROXY_TARGET=http://localhost:8787

# Platform REST API (papers, records, review, upload). Relative paths go through the Vite dev proxy.
VITE_PLATFORM_API_BASE=/api

# Server-side proxy in front of Amplifi. NEVER point this at Amplifi directly with a token in the browser.
VITE_AMPLIFI_PROXY_URL=/amplifi

# Papers loaded in Amplifi, comma-separated. With live chat, only these appear in the chat's paper list
# and on "Ask Amplifi about" buttons. Leave it out to offer every paper.
# VITE_AMPLIFI_PAPERS=CP01,CP02,CP03,CP04,CP05,CP06,CP07,CP08,CP09,CP10

# Request timeout for API calls, in milliseconds. Amplifi agent runs can take over a minute,
# so use 120000 when VITE_CHAT_MODE=live.
VITE_REQUEST_TIMEOUT_MS=30000

# Largest PDF accepted by the upload screen, in megabytes.
VITE_MAX_UPLOAD_MB=50

# Router: "browser" (needs server rewrites to index.html), "hash" (static hosting) or "memory" (embedded demos).
VITE_ROUTER_MODE=browser
