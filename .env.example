# Settings for this app. Copy to .env; none of these is a secret.

# Everything the app shows comes from Amplifi through the proxy: the chat's answers and the Explorer's data.
# Run the proxy with `npm run amplifi:proxy` (settings in .env.amplifi) and set AMPLIFI_PROXY_TARGET below.

# Where the Vite dev server forwards /amplifi (chat, the Explorer's data and the papers' PDFs).
# Defaults to the proxy's default port.
# AMPLIFI_PROXY_TARGET=http://localhost:8787

# Server-side proxy in front of Amplifi. NEVER point this at Amplifi directly with a token in the browser.
VITE_AMPLIFI_PROXY_URL=/amplifi

# Papers loaded in Amplifi, comma-separated. Only these appear in the chat's paper list
# and on "Ask Amplifi about" buttons. Leave it out to offer every paper Amplifi has read.
# VITE_AMPLIFI_PAPERS=CP01,CP02,CP03,CP04,CP05,CP06,CP07,CP08,CP09,CP10

# Request timeout for chat, in milliseconds. Amplifi agent runs can take over a minute.
VITE_REQUEST_TIMEOUT_MS=120000

# Router: "browser" (needs server rewrites to index.html), "hash" (static hosting) or "memory" (embedded demos).
VITE_ROUTER_MODE=browser
