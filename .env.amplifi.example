# Server-only settings for server/amplifi-proxy.mjs (npm run amplifi:proxy).
# Copy this file to .env.amplifi, which is gitignored, and fill it in.
# Never give these a VITE_ prefix or put them in .env: that would ship them to the browser.

# Amplifi API base, including /api/v3. Local Amplifi: http://localhost:8085/api/v3 (nginx)
AMPLIFI_BASE_URL=http://localhost:8085/api/v3

# The Amplifi account the proxy logs in as (the same email and password you use in the Amplifi UI).
AMPLIFI_EMAIL=
AMPLIFI_PASSWORD=

# The chat app to ask (its ID is in the Amplifi UI URL when the chat app is open).
AMPLIFI_CHAT_APP_ID=01a17c36-9cfd-76ee-b4ba-1391e13a9ed2

# For structured (JSON) answers on POST /amplifi/structured, which the Explorer's refresh uses: /chat/upload takes
# a workspace and an agent instead of a chat app. Both IDs are in Amplifi UI addresses; these are the local Battery-POC ones.
AMPLIFI_WORKSPACE_ID=01a17bd8-772a-790b-8d2d-ef488f33dfd0
AMPLIFI_AGENT_ID=81b95890-d0a2-465d-81e2-8feea2c4d65b

# The folder with the papers' PDFs (CP06_Jia_2026.pdf ...). The refresh asks Amplifi about every paper in it and
# checks the answers against these PDFs, and the Explorer opens a paper at a page from here.
# The PDFs stay on this computer: the proxy serves them at /amplifi/papers/CP06.pdf.
AMPLIFI_PAPERS_DIR=C:\SachinK\TWS-data\Battery-POC\Client_docs

# Optional.
# PORT=8787
# AMPLIFI_TIMEOUT_MS=120000

# Optional, for "Refresh from Amplifi". The refresh runs the Python scripts in scripts/explorer, which need
# Python 3.10 or later with pymupdf (pip install pymupdf). It keeps Amplifi's answers and the checked data in
# AMPLIFI_CACHE_DIR, which defaults to server/cache (gitignored).
# AMPLIFI_PYTHON=python
# AMPLIFI_CACHE_DIR=server/cache
