# Server-only settings for server/amplifi-proxy.mjs (npm run amplifi:proxy).
# Copy this file to .env.amplifi, which is gitignored, and fill it in.
# Never give these a VITE_ prefix or put them in .env: that would ship them to the browser.

# Amplifi API base, including /api/v3. Local Amplifi: http://localhost:8085/api/v3 (nginx)
AMPLIFI_BASE_URL=http://localhost:8085/api/v3

# The Amplifi account the proxy logs in as (the same email and password you use in the Amplifi UI).
AMPLIFI_EMAIL=
AMPLIFI_PASSWORD=

# The chat app to ask (its ID is in the Amplifi UI URL when the chat app is open).
AMPLIFI_CHAT_APP_ID=01a17c36-9cfd-76ee-b4ba-1391e13a9ed2

# Optional.
# PORT=8787
# AMPLIFI_TIMEOUT_MS=120000
